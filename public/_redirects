# Digital Asset Links must stay JSON (not the SPA shell).
/.well-known/*  /.well-known/:splat  200

# Blog index (static HTML under /public/blog — article files are served as-is).
/blog   /blog/index.html  200
/blog/  /blog/index.html  200

# Rewrite root-level blog posts (e.g. /0800-level-up-your-building-trust-online.html) to /blog/
/:filename([0-9]{4}-*.html)  /blog/:filename  200

# SPA fallback so /auth, /dashboard, etc. load index.html instead of 404.
/*    /index.html   200
